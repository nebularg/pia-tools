# Configuration for privateinternetaccess.com WireGuard Tunnel
# Generated by pia_setup_tunnel on {{ now | date "2006-01-02 15:04:05 MST" }}
# Using this file spec: {{ spec }}

{{ $tun := . -}}
{{ $reg := $tun.Region -}}

[NetDev]
Name={{ .Interface }}
Kind=wireguard

[WireGuard]
PrivateKey={{ .PrivateKey }}

{{ if $tun.DedicatedIP -}}
# Dedicated IP {{ $tun.DedicatedIP.Ip }} ({{ $tun.DedicatedIP.Cn }}) in region
# {{ $reg.Id }}, valid until {{ $tun.DedicatedIP.Expiry | date "2006-01-02 15:04:05 MST" }}.
{{- else -}}
# Region is {{ $reg.Id }} ({{ $reg.Name }} {{ ($tun | server).Cn }}). The
# latency at the time of configuration was {{ $reg.Latency }}.
{{- end }}

[WireGuardPeer]
Endpoint={{ $tun.ServerIp }}:{{ $tun.ServerPort }}
PublicKey={{ $tun.ServerPubkey }}
AllowedIPs=0.0.0.0/0
PersistentKeepalive=25
